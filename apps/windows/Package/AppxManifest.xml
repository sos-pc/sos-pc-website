<?xml version="1.0" encoding="utf-8"?>
<!-- Template: build.ps1 fills the $...$ tokens. The Store identity values come
     from Partner Center > Product identity (see apps/windows/README.md). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Arch$" />

  <Properties>
    <DisplayName>Talos Diagnostic</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Analyse gratuite de votre PC Windows par Talos Int. Les résultats et les conseils s'affichent sur talos-int.com.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1903+: .NET Framework 4.8 is part of the OS from this version. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="TalosDiagnostic" Executable="TalosDiagnostic.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Talos Diagnostic"
        Description="Diagnostic de votre PC par Talos Int."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Talos Diagnostic" />
      </uap:VisualElements>

      <Extensions>
        <!-- talos-diag: links on talos-int.com start a scan. The URI carries
             no data the app trusts (see LaunchOptions / ReportClient). -->
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="talos-diag" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Talos Diagnostic</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
