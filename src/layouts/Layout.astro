---
export interface Props {
  title?: string;
  description?: string;
}

const { title = "Talos Int. — Dépannage & Solutions Informatiques", description = "Dépannage PC, réparation informatique et création de sites web à Le Castellet (04700). Talos Int., intervention rapide dans les Alpes-de-Haute-Provence. Diagnostic IA gratuit." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/brand-logo/talos-int-icon-dark.svg" />
    <title>{title}</title>
    <meta name="keywords" content="depannage informatique 04700, reparation PC Le Castellet, technicien informatique Alpes-de-Haute-Provence" />
    <meta name="author" content="Talos Int." />
    <link rel="canonical" href="https://www.talos-int.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.talos-int.com/brand-logo/talos-int-dark.svg" />
    <meta property="og:image:width" content="200" />
    <meta property="og:image:height" content="210" />
    <meta property="og:url" content="https://www.talos-int.com" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Talos Int." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content="https://www.talos-int.com/brand-logo/talos-int-dark.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Talos Int.",
      "description": "Dépannage informatique, réparation PC et création de sites web",
      "telephone": "+33769561491",
      "email": "contact@talos-int.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Le Castellet",
        "postalCode": "04700",
        "addressCountry": "FR"
      },
      "url": "https://www.talos-int.com",
      "areaServed": "Alpes-de-Haute-Provence",
      "priceRange": "€€",
      "image": "https://www.talos-int.com/brand-logo/talos-int-dark.svg",
      "openingHours": "Mo-Fr 09:00-18:00",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.95,
        "longitude": 5.98
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://www.talos-int.com"
      }]
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/brand-logo/talos-int-icon-dark.svg" as="image" />
    <script is:inline>
      (function() {
        var theme = localStorage.getItem("theme");
        if (theme === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
          if (!theme) localStorage.setItem("theme", "dark");
        }
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu</a>
    <slot />
  </body>
  <script src="../scripts/main.ts"></script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
      var cover = document.getElementById("sos-pc-cover-page");
      if (!cover) return;
      var body = document.body;
      if (!cover.classList.contains("dismissed") && sessionStorage.getItem("sospc_cover_dismissed_session_v1") !== "true") {
        body.classList.add("cover-active");
      }
      new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
          if (m.target.classList.contains("dismissed")) {
            body.classList.remove("cover-active");
          }
        });
      }).observe(cover, { attributes: true, attributeFilter: ["class"] });
    });
  </script>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
