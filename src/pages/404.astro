---
import Layout from "../layouts/Layout.astro";
import AsciiBackground from "../components/AsciiBackground.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const routes = [
  { href: "/", label: "accueil/" },
  { href: "/#services", label: "services/" },
  { href: "/#diagnostic", label: "diagnostic/" },
  { href: "/audit/", label: "audit/" },
  { href: "/#contact", label: "contact/" },
  { href: "/man/legal/", label: "legal/" },
];
---

<Layout title="404 — Page introuvable | Talos Int." description="Cette page n'existe pas ou a été déplacée." noindex>
  <AsciiBackground />
  <Navbar />
  <main id="main-content">
    <section class="nf-section">
      <div class="nf-content">
        <div class="nf-badge">
          <span class="tag tag-red">Erreur 404</span>
          <span class="nf-hint mono">// page introuvable</span>
        </div>
        <p class="nf-code mono" data-text="404" aria-hidden="true">404</p>
        <h1 class="nf-title">Cette page est <em>introuvable</em></h1>
        <p class="nf-sub">
          Diagnostic terminé : votre connexion va bien, votre ordinateur aussi.
          C'est le lien qui est cassé — il est peut-être ancien, mal saisi, ou la page a déménagé.
        </p>
        <div class="nf-actions">
          <a href="/" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path></svg>
            Retour à l'accueil
          </a>
          <a href="/#diagnostic" class="btn-ghost">Diagnostiquer mon PC</a>
          <a href="/#contact" class="btn-ghost">Nous contacter</a>
        </div>
      </div>

      <div class="nf-terminal">
        <div class="nf-bar">
          <span class="t-dot red"></span>
          <span class="t-dot yellow"></span>
          <span class="t-dot green"></span>
          <span class="nf-bar-title mono">talos-diag — 404</span>
        </div>
        <div class="nf-body mono">
          <div class="nf-l" style="--d: 0.1s"><span class="nf-prompt">$</span> talos-diag --url <span id="nf-path" class="nf-path">/cette-page</span></div>
          <div class="nf-l nf-out" style="--d: 0.5s"><span class="nf-ok">[ OK ]</span> Connexion internet</div>
          <div class="nf-l nf-out" style="--d: 0.8s"><span class="nf-ok">[ OK ]</span> Serveur talos-int.com joignable</div>
          <div class="nf-l nf-out" style="--d: 1.1s"><span class="nf-ok">[ OK ]</span> Certificat SSL valide</div>
          <div class="nf-l nf-out" style="--d: 1.5s"><span class="nf-fail">[FAIL]</span> Page introuvable (HTTP 404)</div>
          <div class="nf-l nf-out nf-note" style="--d: 1.9s">→ Cause : lien cassé. Ce n'est pas votre machine, pour une fois.</div>
          <div class="nf-l" style="--d: 2.4s"><span class="nf-prompt">$</span> ls ~/talos-int</div>
          <nav class="nf-l nf-out nf-ls" style="--d: 2.7s" aria-label="Pages du site">
            {routes.map((r) => <a href={r.href}>{r.label}</a>)}
          </nav>
          <div class="nf-l" style="--d: 3s"><span class="nf-prompt">$</span> <span class="t-cursor">_</span></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  (function () {
    var el = document.getElementById("nf-path");
    if (!el) return;
    var path = location.pathname;
    try { path = decodeURIComponent(path); } catch (e) {}
    if (path.length > 48) path = path.slice(0, 45) + "...";
    el.textContent = path;
  })();
</script>

<style>
  .nf-section {
    --nf-ok: var(--accent-hex);
    --nf-fail: var(--red);
    --nf-note: var(--yellow);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: calc(100vh - var(--navbar-h) - 120px);
    padding: calc(var(--navbar-h) + 3rem) 0 4rem;
  }

  :global(html:not(.dark)) .nf-section {
    --nf-fail: #c2334d;
    --nf-note: #9a6b1f;
  }

  .nf-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0.5rem;
  }

  .nf-hint {
    font-size: 12px;
    color: var(--text-dim);
  }

  /* Big glitching 404 */
  .nf-code {
    position: relative;
    display: inline-block;
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-hex);
    text-shadow: 0 0 24px rgba(var(--accent), 0.35);
    margin: 0.25rem 0 1rem;
  }

  .nf-code::before,
  .nf-code::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .nf-code::before {
    color: var(--red);
    animation: nf-glitch-a 4s steps(1) infinite;
  }

  .nf-code::after {
    color: var(--blue);
    animation: nf-glitch-b 4s steps(1) infinite;
  }

  @keyframes nf-glitch-a {
    0%, 86%, 100% { opacity: 0; transform: none; clip-path: none; }
    88% { opacity: 0.8; transform: translate(-4px, 1px); clip-path: inset(10% 0 55% 0); }
    91% { opacity: 0.8; transform: translate(3px, -1px); clip-path: inset(60% 0 8% 0); }
    94% { opacity: 0; }
  }

  @keyframes nf-glitch-b {
    0%, 87%, 100% { opacity: 0; transform: none; clip-path: none; }
    89% { opacity: 0.7; transform: translate(4px, -1px); clip-path: inset(35% 0 30% 0); }
    92% { opacity: 0.7; transform: translate(-3px, 2px); clip-path: inset(5% 0 70% 0); }
    95% { opacity: 0; }
  }

  .nf-title {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin-bottom: 1rem;
  }

  .nf-title em {
    font-style: normal;
    color: var(--accent-hex);
  }

  .nf-sub {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .nf-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Terminal */
  .nf-terminal {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 0 30px #0006, 0 0 0 1px #00d4aa0d;
  }

  .nf-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-elevated);
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
  }

  .t-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .t-dot.red { background: #f7768e; }
  .t-dot.yellow { background: #e0af68; }
  .t-dot.green { background: #00d4aa; }

  .nf-bar-title {
    font-size: 12px;
    color: var(--text-muted);
    margin-left: 8px;
  }

  .nf-body {
    background: #0d0e14;
    padding: 20px;
    font-size: 13px;
    line-height: 1.9;
    color: #c0caf5;
  }

  :global(html:not(.dark)) .nf-body {
    background: var(--bg-elevated);
    color: var(--text);
  }

  .nf-l {
    opacity: 0;
    animation: nf-in 0.25s ease-out forwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes nf-in {
    from { opacity: 0; transform: translateY(2px); }
    to { opacity: 1; transform: none; }
  }

  .nf-out { padding-left: 16px; }
  .nf-prompt { color: var(--accent-hex); font-weight: 600; margin-right: 6px; }
  .nf-path { color: var(--nf-note); word-break: break-all; }
  .nf-ok { color: var(--nf-ok); }
  .nf-fail { color: var(--nf-fail); font-weight: 600; }
  .nf-note { color: var(--nf-note); }

  .nf-ls {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .nf-ls a {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  :global(html:not(.dark)) .nf-ls a { color: #2e5cb8; }

  .nf-ls a:hover,
  .nf-ls a:focus-visible {
    text-decoration-color: currentColor;
    opacity: 1;
  }

  .t-cursor {
    color: var(--accent-hex);
    animation: nf-blink 1s step-end infinite;
  }

  @keyframes nf-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-l { animation: none; opacity: 1; }
    .nf-code::before,
    .nf-code::after { animation: none; opacity: 0; }
  }

  @media (max-width: 900px) {
    .nf-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      min-height: auto;
      padding-top: calc(var(--navbar-h) + 2rem);
    }
  }

  @media (max-width: 600px) {
    .nf-body { font-size: 12px; padding: 16px; }
    .nf-actions a { flex: 1 1 100%; justify-content: center; }
  }
</style>
