---
import Layout from "../layouts/Layout.astro";
import AsciiBackground from "../components/AsciiBackground.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Audit Web — SOS-PC" description="Analysez gratuitement les performances, le SEO et l'accessibilité de votre site web sur mobile et desktop. Rapport détaillé en français.">
  <AsciiBackground />
  <Navbar />
  <main id="main-content">
    <section class="audit-section">
      <div class="section-label">
        <span class="tag tag-blue">outil</span>
        <span class="mono text-muted">// Audit Web gratuit</span>
      </div>

      <div class="audit-header">
        <h1>Audit <span class="teal">Web</span> gratuit</h1>
        <p>Analysez les performances, le SEO, l'accessibilité et les bonnes pratiques de votre site sur mobile <em>et</em> desktop. Rapport détaillé en français, prêt à transmettre.</p>
      </div>

      <div class="audit-input-wrap">
        <div class="audit-terminal">
          <div class="terminal-bar">
            <span class="t-dot red"></span>
            <span class="t-dot yellow"></span>
            <span class="t-dot green"></span>
            <span class="t-title">audit-web.sh — bash</span>
          </div>
          <div class="terminal-body">
            <div class="t-line">
              <span class="t-prompt">$</span>
              <span class="t-cmd">audit</span>
              <form id="audit-form" class="audit-form">
                <input
                  id="audit-url"
                  type="url"
                  name="url"
                  placeholder="https://votre-site.fr"
                  required
                  autocomplete="url"
                  spellcheck="false"
                  class="audit-input"
                />
                <button type="submit" class="audit-submit" id="audit-submit-btn">
                  <span id="audit-submit-label">Analyser</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
              </form>
            </div>
            <div class="t-line competitor-toggle-line">
              <button type="button" id="competitor-toggle-btn" class="competitor-toggle-btn">
                <span id="competitor-toggle-label">+ comparer un concurrent</span>
              </button>
            </div>

            <div class="t-line t-competitor-line" id="competitor-line" style="display:none;">
              <span class="t-prompt" style="color:var(--text-dim)">$</span>
              <span class="t-cmd" style="color:var(--text-dim)">compare</span>
              <input
                id="competitor-url"
                type="url"
                name="competitorUrl"
                placeholder="https://concurrent.fr (optionnel)"
                autocomplete="off"
                spellcheck="false"
                class="audit-input competitor-input"
              />
            </div>

            <div id="audit-output" class="audit-output" style="display:none;">
              <div class="t-output" id="audit-status">Connexion au serveur d'analyse...</div>
            </div>
          </div>
        </div>
      </div>

      <div id="audit-results" class="audit-results" style="display:none;">

        <div class="audit-overview">
          <div class="overall-card">
            <div class="overall-ring" id="overall-ring">
              <span class="overall-val" id="overall-val">—</span>
              <span class="overall-suffix mono">/100</span>
            </div>
            <div class="overall-meta">
              <h2 id="overall-verdict" class="overall-verdict mono">Analyse</h2>
              <p id="overall-summary" class="overall-summary"></p>
              <p class="overall-mobile-note mono">// score Google de référence (mobile)</p>
            </div>
          </div>

          <div class="screenshots-card">
            <div class="screenshots-header mono">// aperçu du site</div>
            <div class="screenshots-grid">
              <div class="screenshot-slot screenshot-mobile" id="screenshot-mobile-slot" style="display:none;">
                <div class="screenshot-frame frame-mobile">
                  <img id="screenshot-mobile-img" alt="Aperçu mobile du site" />
                </div>
                <span class="screenshot-label mono">📱 mobile</span>
              </div>
              <div class="screenshot-slot screenshot-desktop" id="screenshot-desktop-slot" style="display:none;">
                <div class="screenshot-frame frame-desktop">
                  <img id="screenshot-desktop-img" alt="Aperçu desktop du site" />
                </div>
                <span class="screenshot-label mono">🖥️ desktop</span>
              </div>
            </div>
          </div>
        </div>

        <div class="strategy-toggle" id="strategy-toggle">
          <button type="button" class="strat-btn active" data-strategy="mobile" id="strat-btn-mobile">
            📱 Mobile
            <span class="strat-score mono" id="strat-score-mobile">—</span>
          </button>
          <button type="button" class="strat-btn" data-strategy="desktop" id="strat-btn-desktop">
            🖥️ Desktop
            <span class="strat-score mono" id="strat-score-desktop">—</span>
          </button>
        </div>

        <div class="audit-scores" id="audit-scores"></div>

        <!-- E18 — Stack technique détectée -->
        <div class="tech-wrap" id="tech-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Stack technique détectée</h3>
          <p class="audit-section-sub">Technologies identifiées automatiquement sur votre site.</p>
          <div class="tech-badges" id="tech-badges"></div>
        </div>

        <!-- E2 — Comparaison concurrent -->
        <div class="competitor-wrap" id="competitor-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Comparaison concurrent</h3>
          <p class="audit-section-sub" id="competitor-sub"></p>
          <div class="competitor-grid" id="competitor-grid"></div>
        </div>

        <div class="vitals-wrap" id="vitals-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Core Web Vitals</h3>
          <p class="audit-section-sub">Les métriques que Google utilise pour juger l'expérience de vos visiteurs.</p>
          <div class="vitals-grid" id="vitals-grid"></div>
        </div>

        <div class="quickwins-wrap" id="quickwins-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Quick wins</h3>
          <p class="audit-section-sub">Actions rapides à fort impact pour faire grimper votre score.</p>
          <div class="quickwins-list" id="quickwins-list"></div>
        </div>

        <div class="audit-issues-wrap" id="audit-issues-wrap">
          <h3 class="audit-section-title mono">// Tous les problèmes détectés</h3>
          <p class="audit-section-sub" id="issues-sub"></p>
          <div id="audit-issues" class="audit-issues"></div>
        </div>

        <div class="budget-card" id="budget-card" style="display:none;">
          <div class="budget-header">
            <span class="mono budget-label">// Estimation budget de correction</span>
          </div>
          <div class="budget-body">
            <div class="budget-amount">
              <span class="budget-range mono" id="budget-range">—</span>
              <span class="budget-meta mono" id="budget-meta">—</span>
            </div>
            <p class="budget-note">Fourchette indicative basée sur les tarifs SOS-PC. Le devis final dépend de la complexité de votre site et des priorités retenues.</p>
          </div>
        </div>

        <div class="audit-actions">
          <button class="btn-primary" id="audit-attach-btn" style="display:none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
            Joindre au formulaire de contact
          </button>
          <button class="btn-ghost" id="audit-pdf-btn" style="display:none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <span id="audit-pdf-label">Télécharger PDF</span>
          </button>
          <a href="/#contact" class="btn-ghost" id="audit-contact-btn" style="display:none;">
            Refaire mon site avec SOS-PC →
          </a>
        </div>
      </div>

    </section>
  </main>
  <Footer />
</Layout>

<script>
  type Strategy = "mobile" | "desktop";

  const form = document.getElementById("audit-form") as HTMLFormElement;
  const urlInput = document.getElementById("audit-url") as HTMLInputElement;
  const submitBtn = document.getElementById("audit-submit-btn") as HTMLButtonElement;
  const submitLabel = document.getElementById("audit-submit-label") as HTMLElement;
  const output = document.getElementById("audit-output") as HTMLElement;
  const status = document.getElementById("audit-status") as HTMLElement;
  const results = document.getElementById("audit-results") as HTMLElement;
  const scores = document.getElementById("audit-scores") as HTMLElement;
  const issuesWrap = document.getElementById("audit-issues-wrap") as HTMLElement;
  const issues = document.getElementById("audit-issues") as HTMLElement;
  const issuesSub = document.getElementById("issues-sub") as HTMLElement;
  const quickwinsWrap = document.getElementById("quickwins-wrap") as HTMLElement;
  const quickwinsList = document.getElementById("quickwins-list") as HTMLElement;
  const vitalsWrap = document.getElementById("vitals-wrap") as HTMLElement;
  const vitalsGrid = document.getElementById("vitals-grid") as HTMLElement;
  const overallRing = document.getElementById("overall-ring") as HTMLElement;
  const overallVal = document.getElementById("overall-val") as HTMLElement;
  const overallVerdict = document.getElementById("overall-verdict") as HTMLElement;
  const overallSummary = document.getElementById("overall-summary") as HTMLElement;
  const mobileSlot = document.getElementById("screenshot-mobile-slot") as HTMLElement;
  const desktopSlot = document.getElementById("screenshot-desktop-slot") as HTMLElement;
  const mobileImg = document.getElementById("screenshot-mobile-img") as HTMLImageElement;
  const desktopImg = document.getElementById("screenshot-desktop-img") as HTMLImageElement;
  const stratBtnMobile = document.getElementById("strat-btn-mobile") as HTMLButtonElement;
  const stratBtnDesktop = document.getElementById("strat-btn-desktop") as HTMLButtonElement;
  const stratScoreMobile = document.getElementById("strat-score-mobile") as HTMLElement;
  const stratScoreDesktop = document.getElementById("strat-score-desktop") as HTMLElement;
  const budgetCard = document.getElementById("budget-card") as HTMLElement;
  const budgetRange = document.getElementById("budget-range") as HTMLElement;
  const budgetMeta = document.getElementById("budget-meta") as HTMLElement;
  const attachBtn = document.getElementById("audit-attach-btn") as HTMLElement;
  const contactBtn = document.getElementById("audit-contact-btn") as HTMLElement;
  const pdfBtn = document.getElementById("audit-pdf-btn") as HTMLElement;
  const pdfLabel = document.getElementById("audit-pdf-label") as HTMLElement;
  const techWrap = document.getElementById("tech-wrap") as HTMLElement;
  const techBadges = document.getElementById("tech-badges") as HTMLElement;
  const competitorWrap = document.getElementById("competitor-wrap") as HTMLElement;
  const competitorGrid = document.getElementById("competitor-grid") as HTMLElement;
  const competitorSub = document.getElementById("competitor-sub") as HTMLElement;
  const competitorToggleBtn = document.getElementById("competitor-toggle-btn") as HTMLButtonElement;
  const competitorToggleLabel = document.getElementById("competitor-toggle-label") as HTMLElement;
  const competitorLine = document.getElementById("competitor-line") as HTMLElement;
  const competitorInput = document.getElementById("competitor-url") as HTMLInputElement;

  let lastReport: any = null;
  let currentStrategy: Strategy = "mobile";

  const SCORE_LABELS = [
    { key: "performance", label: "Performance", icon: "⚡" },
    { key: "seo", label: "SEO", icon: "🔍" },
    { key: "accessibility", label: "Accessibilité", icon: "♿" },
    { key: "best-practices", label: "Bonnes pratiques", icon: "✓" },
  ];

  const EFFORT_LABELS: Record<string, { label: string; color: string }> = {
    easy: { label: "facile", color: "var(--accent-hex)" },
    medium: { label: "moyen", color: "var(--yellow)" },
    hard: { label: "important", color: "var(--purple)" },
  };

  // Indicative price ranges per effort level (EUR).
  // Adjust these constants to match your actual offer.
  const EFFORT_PRICE: Record<string, { min: number; max: number }> = {
    easy: { min: 50, max: 150 },
    medium: { min: 200, max: 500 },
    hard: { min: 600, max: 1200 },
  };

  function computeBudget(items: any[]): { min: number; max: number; count: number } {
    let min = 0;
    let max = 0;
    items.forEach((i) => {
      const range = EFFORT_PRICE[i.effort] || EFFORT_PRICE.medium;
      min += range.min;
      max += range.max;
    });
    return { min, max, count: items.length };
  }

  function formatEur(n: number): string {
    return new Intl.NumberFormat("fr-FR").format(n) + " €";
  }

  function scoreColor(score: number): string {
    if (score >= 90) return "var(--accent-hex)";
    if (score >= 50) return "var(--yellow)";
    return "var(--red)";
  }

  function verdictFor(score: number): string {
    if (score >= 90) return "Excellent";
    if (score >= 70) return "Correct";
    if (score >= 50) return "À optimiser";
    return "Critique";
  }

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function animateScore(target: HTMLElement, from: number, to: number, duration: number) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      target.textContent = String(to);
      return;
    }
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(1, elapsed / duration);
      const value = Math.round(from + (to - from) * ease(progress));
      target.textContent = String(value);
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function animateRing(ring: HTMLElement, from: number, to: number, duration: number) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      ring.style.setProperty("--pct", String(to));
      return;
    }
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(1, elapsed / duration);
      const value = from + (to - from) * ease(progress);
      ring.style.setProperty("--pct", String(value));
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function renderOverallFromMobile(data: any) {
    const mobile = data.mobile;
    const score = mobile?.scoreOverall ?? 0;
    const color = scoreColor(score);
    overallRing.style.setProperty("--color", color);
    overallVal.style.color = color;
    overallVerdict.textContent = verdictFor(score);
    overallVerdict.style.color = color;

    animateScore(overallVal, 0, score, 1500);
    animateRing(overallRing, 0, score, 1500);

    const s = mobile?.summary || { critical: 0, warning: 0, passed: 0 };
    const parts: string[] = [];
    if (s.critical) parts.push(`${s.critical} problème${s.critical > 1 ? "s" : ""} critique${s.critical > 1 ? "s" : ""}`);
    if (s.warning) parts.push(`${s.warning} amélioration${s.warning > 1 ? "s" : ""} possible${s.warning > 1 ? "s" : ""}`);
    if (s.passed) parts.push(`${s.passed} test${s.passed > 1 ? "s" : ""} réussi${s.passed > 1 ? "s" : ""}`);
    overallSummary.textContent = parts.length ? parts.join(" · ") : "Tous les tests sont passés.";
  }

  function renderScreenshots(data: any) {
    const m = data.mobile?.screenshot;
    const d = data.desktop?.screenshot;
    if (m) {
      mobileImg.src = m;
      mobileSlot.style.display = "flex";
    } else {
      mobileSlot.style.display = "none";
    }
    if (d) {
      desktopImg.src = d;
      desktopSlot.style.display = "flex";
    } else {
      desktopSlot.style.display = "none";
    }
  }

  function renderToggle(data: any) {
    const mScore = data.mobile?.scoreOverall ?? 0;
    const dScore = data.desktop?.scoreOverall ?? 0;
    stratScoreMobile.textContent = mScore + "/100";
    stratScoreDesktop.textContent = dScore + "/100";
    stratScoreMobile.style.color = scoreColor(mScore);
    stratScoreDesktop.style.color = scoreColor(dScore);
  }

  function renderScores(strat: any) {
    scores.innerHTML = "";
    SCORE_LABELS.forEach(({ key, label, icon }) => {
      const val = strat?.scores?.[key] ?? 0;
      const pct = Math.round(val * 100);
      const color = scoreColor(pct);
      scores.innerHTML += `
        <div class="score-card">
          <div class="score-ring" style="--pct:${pct};--color:${color}">
            <span class="score-val" style="color:${color}">${pct}</span>
          </div>
          <span class="score-label mono">${icon} ${label}</span>
        </div>`;
    });
  }

  function renderVitals(vitals: any[]) {
    if (!vitals || vitals.length === 0) {
      vitalsWrap.style.display = "none";
      return;
    }
    vitalsWrap.style.display = "block";
    vitalsGrid.innerHTML = "";
    vitals.forEach((v: any) => {
      const ratingClass = v.rating === "good" ? "vital-good" : v.rating === "needs-improvement" ? "vital-warn" : "vital-poor";
      const ratingLabel = v.rating === "good" ? "Bon" : v.rating === "needs-improvement" ? "À améliorer" : "Mauvais";
      vitalsGrid.innerHTML += `
        <div class="vital-card ${ratingClass}">
          <span class="vital-label mono">${escapeHtml(v.label)}</span>
          <span class="vital-value">${escapeHtml(v.value)}</span>
          <span class="vital-rating mono">${ratingLabel}</span>
        </div>`;
    });
  }

  function renderQuickWins(items: any[]) {
    if (!items || items.length === 0) {
      quickwinsWrap.style.display = "none";
      return;
    }
    quickwinsWrap.style.display = "block";
    quickwinsList.innerHTML = "";
    items.forEach((item: any, idx: number) => {
      const effort = EFFORT_LABELS[item.effort] || EFFORT_LABELS.medium;
      quickwinsList.innerHTML += `
        <div class="qw-item">
          <span class="qw-num mono">${idx + 1}</span>
          <div class="qw-body">
            <div class="qw-head">
              <span class="qw-title">${escapeHtml(item.title)}</span>
              <span class="qw-tag mono" style="color:${effort.color};border-color:${effort.color}">effort ${effort.label}</span>
            </div>
            <span class="qw-desc">${escapeHtml(item.description || "")}</span>
            ${item.impact ? `<span class="qw-impact"><span class="impact-icon mono">→</span> ${escapeHtml(item.impact)}</span>` : ""}
            <span class="qw-cat mono">${escapeHtml(item.category || "")}</span>
          </div>
        </div>`;
    });
  }

  function renderIssues(items: any[]) {
    issues.innerHTML = "";
    if (!items || !items.length) {
      issuesWrap.style.display = "none";
      return;
    }
    issuesWrap.style.display = "block";
    issuesSub.textContent = `${items.length} audit${items.length > 1 ? "s" : ""} ayant échoué, triés par sévérité.`;

    items.forEach((item: any) => {
      const lvl = item.level === "error" ? "err" : item.level === "warning" ? "warn" : "ok";
      const icon = lvl === "err" ? "✗" : lvl === "warn" ? "⚠" : "✓";
      const effort = EFFORT_LABELS[item.effort] || EFFORT_LABELS.medium;
      issues.innerHTML += `
        <div class="issue-item issue-${lvl}">
          <span class="issue-icon mono">${icon}</span>
          <div class="issue-body">
            <div class="issue-head">
              <span class="issue-title">${escapeHtml(item.title)}</span>
              <span class="issue-cat mono">${escapeHtml(item.category || "")}</span>
              <span class="issue-effort mono" style="color:${effort.color};border-color:${effort.color}">${effort.label}</span>
            </div>
            <span class="issue-desc">${escapeHtml(item.description || "")}</span>
            ${item.impact ? `<span class="issue-impact"><span class="impact-icon mono">→</span> ${escapeHtml(item.impact)}</span>` : ""}
          </div>
        </div>`;
    });
  }

  function renderBudget(items: any[]) {
    if (!items || items.length === 0) {
      budgetCard.style.display = "none";
      return;
    }
    const { min, max, count } = computeBudget(items);
    budgetRange.textContent = `${formatEur(min)} — ${formatEur(max)}`;
    budgetMeta.textContent = `pour corriger ${count} problème${count > 1 ? "s" : ""}`;
    budgetCard.style.display = "block";
  }

  competitorToggleBtn.addEventListener("click", () => {
    const isVisible = competitorLine.style.display !== "none";
    competitorLine.style.display = isVisible ? "none" : "flex";
    competitorToggleLabel.textContent = isVisible ? "+ comparer un concurrent" : "− masquer concurrent";
    if (isVisible) competitorInput.value = "";
  });

  const TECH_CATEGORY_COLORS: Record<string, string> = {
    CMS: "#7aa2f7",
    Framework: "#bb9af7",
    JS: "#e0af68",
    CSS: "#2ac3de",
    Analytics: "#9ece6a",
    Serveur: "#f7768e",
    Autre: "#a9b1d6",
  };

  function renderTechStack(techs: any[]) {
    if (!techs || techs.length === 0) {
      techWrap.style.display = "none";
      return;
    }
    techWrap.style.display = "block";
    techBadges.innerHTML = "";
    techs.forEach((t: any) => {
      const color = TECH_CATEGORY_COLORS[t.category] || TECH_CATEGORY_COLORS.Autre;
      const version = t.version ? ` <span class="tech-version">${escapeHtml(t.version)}</span>` : "";
      techBadges.innerHTML += `
        <span class="tech-badge" style="--tech-color:${color}">
          <span class="tech-cat">${escapeHtml(t.category)}</span>
          <span class="tech-name">${escapeHtml(t.name)}</span>${version}
        </span>`;
    });
  }

  function renderCompetitor(data: any) {
    const comp = data.competitor;
    if (!comp) {
      competitorWrap.style.display = "none";
      return;
    }
    competitorWrap.style.display = "block";
    const myUrl = data.finalUrl || data.url || "Votre site";
    const compUrl = comp.finalUrl || comp.url || "Concurrent";
    competitorSub.textContent = `${myUrl} vs ${compUrl} — Mobile · Desktop`;

    const SCORE_LABELS_LOCAL = [
      { key: "performance", label: "Performance", icon: "⚡" },
      { key: "seo", label: "SEO", icon: "🔍" },
      { key: "accessibility", label: "Accessibilité", icon: "♿" },
      { key: "best-practices", label: "Bonnes pratiques", icon: "✓" },
    ];

    function scoreBadge(pct: number): string {
      const color = scoreColor(pct);
      return `<span class="comp-score" style="color:${color};border-color:${color}">${pct}</span>`;
    }

    function stratRows(myStrat: any, compStrat: any): string {
      return SCORE_LABELS_LOCAL.map(({ key, label, icon }) => {
        const myPct = Math.round((myStrat?.scores?.[key] ?? 0) * 100);
        const cPct = Math.round((compStrat?.scores?.[key] ?? 0) * 100);
        const myWin = myPct >= cPct;
        return `
          <div class="comp-row">
            <div class="comp-cell comp-cell-you ${myWin ? "comp-winner" : ""}">${scoreBadge(myPct)}</div>
            <div class="comp-cell comp-label mono">${icon} ${escapeHtml(label)}</div>
            <div class="comp-cell comp-cell-them ${!myWin ? "comp-winner" : ""}">${scoreBadge(cPct)}</div>
          </div>`;
      }).join("");
    }

    const myOverallM = data.mobile?.scoreOverall ?? 0;
    const myOverallD = data.desktop?.scoreOverall ?? 0;
    const cOverallM = comp.mobile?.scoreOverall ?? 0;
    const cOverallD = comp.desktop?.scoreOverall ?? 0;

    competitorGrid.innerHTML = `
      <div class="comp-table">
        <div class="comp-header">
          <div class="comp-hcell comp-hcell-you mono">📱 Vous</div>
          <div class="comp-hcell comp-hcell-label mono">Mobile</div>
          <div class="comp-hcell comp-hcell-them mono">📱 Eux</div>
        </div>
        <div class="comp-overall-row">
          <div class="comp-overall-val ${myOverallM >= cOverallM ? "comp-overall-win" : ""}">${myOverallM}<span class="comp-overall-suffix">/100</span></div>
          <div class="comp-overall-label mono">Score global</div>
          <div class="comp-overall-val ${cOverallM > myOverallM ? "comp-overall-win" : ""}">${cOverallM}<span class="comp-overall-suffix">/100</span></div>
        </div>
        ${stratRows(data.mobile, comp.mobile)}
      </div>
      <div class="comp-table">
        <div class="comp-header">
          <div class="comp-hcell comp-hcell-you mono">🖥️ Vous</div>
          <div class="comp-hcell comp-hcell-label mono">Desktop</div>
          <div class="comp-hcell comp-hcell-them mono">🖥️ Eux</div>
        </div>
        <div class="comp-overall-row">
          <div class="comp-overall-val ${myOverallD >= cOverallD ? "comp-overall-win" : ""}">${myOverallD}<span class="comp-overall-suffix">/100</span></div>
          <div class="comp-overall-label mono">Score global</div>
          <div class="comp-overall-val ${cOverallD > myOverallD ? "comp-overall-win" : ""}">${cOverallD}<span class="comp-overall-suffix">/100</span></div>
        </div>
        ${stratRows(data.desktop, comp.desktop)}
      </div>`;
  }

  function applyStrategy(strategy: Strategy) {
    currentStrategy = strategy;
    stratBtnMobile.classList.toggle("active", strategy === "mobile");
    stratBtnDesktop.classList.toggle("active", strategy === "desktop");
    if (!lastReport) return;
    const strat = strategy === "mobile" ? lastReport.mobile : lastReport.desktop;
    renderScores(strat);
    renderVitals(strat?.vitals || []);
    renderQuickWins(strat?.quickWins || []);
    renderIssues(strat?.issues || []);
    renderBudget(strat?.issues || []);
  }

  stratBtnMobile.addEventListener("click", () => applyStrategy("mobile"));
  stratBtnDesktop.addEventListener("click", () => applyStrategy("desktop"));

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitLabel.textContent = loading ? "Analyse..." : "Analyser";
    urlInput.readOnly = loading;
  }

  function showOutput(text: string) {
    output.style.display = "block";
    status.textContent = text;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const url = urlInput.value.trim();
    if (!url) return;

    setLoading(true);
    results.style.display = "none";
    attachBtn.style.display = "none";
    contactBtn.style.display = "none";
    showOutput("Connexion au serveur d'analyse...");

    const steps = [
      "Résolution DNS...",
      "Audit mobile (4G simulé)...",
      "Audit desktop (haut débit)...",
      "Capture des écrans...",
      "Analyse des Core Web Vitals...",
      "Audit SEO et accessibilité...",
      "Compilation du rapport...",
    ];

    let stepIdx = 0;
    const stepTimer = setInterval(() => {
      stepIdx++;
      if (stepIdx < steps.length) status.textContent = steps[stepIdx];
    }, 5000);

    try {
      const competitorVal = competitorInput.value.trim();
      const body: Record<string, string> = { url };
      if (competitorVal) body.competitorUrl = competitorVal;

      const res = await fetch("/.netlify/functions/audit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      clearInterval(stepTimer);

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: "Erreur serveur" }));
        throw new Error(err.error || `Erreur ${res.status}`);
      }

      const data = await res.json();
      lastReport = data;

      showOutput(`✓ Analyse terminée pour ${data.finalUrl || url}`);

      renderOverallFromMobile(data);
      renderScreenshots(data);
      renderToggle(data);
      renderTechStack(data.techStack || []);
      renderCompetitor(data);
      applyStrategy("mobile");

      results.style.display = "block";
      attachBtn.style.display = "inline-flex";
      pdfBtn.style.display = "inline-flex";
      contactBtn.style.display = "inline-flex";
    } catch (err: any) {
      clearInterval(stepTimer);
      showOutput(`✗ Erreur : ${err.message || "Impossible d'analyser ce site."}`);
    } finally {
      setLoading(false);
    }
  });

  attachBtn.addEventListener("click", () => {
    if (!lastReport) return;
    const text = buildReport(lastReport);
    const message = buildHumanMessage(lastReport);
    const payload = {
      text,
      message,
      generated: new Date().toLocaleString("fr-FR"),
      score: lastReport.mobile?.scoreOverall ?? 0,
      issues: lastReport.mobile?.issues || [],
      symptoms_user: [],
      url: lastReport.finalUrl || lastReport.url || "",
    };
    try {
      localStorage.setItem("sospc_web_audit_v1", JSON.stringify(payload));
    } catch {}
    window.location.href = "/#contact";
  });

  function buildHumanMessage(data: any): string {
    const lines: string[] = [];
    const url = data.finalUrl || data.url || "";
    const mScore = data.mobile?.scoreOverall ?? 0;
    const dScore = data.desktop?.scoreOverall ?? 0;
    const mSummary = data.mobile?.summary || { critical: 0, warning: 0 };
    const dSummary = data.desktop?.summary || { critical: 0, warning: 0 };
    const mIssues = data.mobile?.issues || [];
    const dIssues = data.desktop?.issues || [];

    lines.push(`Bonjour,`);
    lines.push("");
    lines.push(`J'ai utilisé l'outil d'audit de SOS-PC sur ${url} et j'aimerais discuter des corrections possibles.`);
    lines.push("");
    lines.push(`Résultat de l'audit :`);
    lines.push(`  • Score mobile  : ${mScore}/100 (${verdictFor(mScore)})`);
    lines.push(`  • Score desktop : ${dScore}/100 (${verdictFor(dScore)})`);
    lines.push(`  • ${mSummary.critical || 0} problème(s) critique(s) sur mobile, ${dSummary.critical || 0} sur desktop`);

    const allIssues = [...mIssues, ...dIssues];
    if (allIssues.length > 0) {
      const budget = computeBudget(mIssues.length >= dIssues.length ? mIssues : dIssues);
      lines.push(`  • Budget estimé pour corrections : ${formatEur(budget.min)} — ${formatEur(budget.max)}`);
    }

    const criticals = mIssues.filter((i: any) => i.level === "error").slice(0, 3);
    if (criticals.length > 0) {
      lines.push("");
      lines.push("Principaux problèmes critiques (mobile) :");
      criticals.forEach((c: any) => {
        lines.push(`  • ${c.title}`);
      });
    }

    lines.push("");
    lines.push(`Merci de me recontacter pour discuter d'un devis.`);
    return lines.join("\n");
  }

  function buildScoresLines(label: string, strat: any): string[] {
    const lines: string[] = [];
    lines.push(`SCORES ${label.toUpperCase()}`);
    SCORE_LABELS.forEach(({ key, label: l }) => {
      const pct = Math.round((strat?.scores?.[key] ?? 0) * 100);
      const filled = Math.round(pct / 5);
      const bar = "#".repeat(filled) + "-".repeat(20 - filled);
      lines.push(`  ${l.padEnd(18)} [${bar}] ${String(pct).padStart(3, " ")}/100`);
    });
    return lines;
  }

  function buildIssuesLines(strat: any): string[] {
    const lines: string[] = [];
    if (strat?.issues?.length) {
      lines.push(`PROBLÈMES DÉTECTÉS (${strat.issues.length})`);
      strat.issues.forEach((i: any) => {
        const lvl = i.level === "error" ? "[CRITIQUE]" : "[ATTENTION]";
        lines.push(`${lvl} ${i.title}  (${i.category || "—"} · effort ${i.effort})`);
        if (i.description) lines.push(`           ${i.description}`);
        if (i.impact) lines.push(`           → ${i.impact}`);
        lines.push("");
      });
      const budget = computeBudget(strat.issues);
      lines.push(`BUDGET ESTIMÉ : ${formatEur(budget.min)} — ${formatEur(budget.max)}  (${budget.count} corrections)`);
      lines.push("");
    }
    return lines;
  }

  function buildVitalsLines(strat: any): string[] {
    const lines: string[] = [];
    if (strat?.vitals?.length) {
      lines.push("CORE WEB VITALS");
      strat.vitals.forEach((v: any) => {
        const ratingLabel = v.rating === "good" ? "BON" : v.rating === "needs-improvement" ? "À AMÉLIORER" : "MAUVAIS";
        lines.push(`  ${v.label.padEnd(35)} ${v.value.padStart(8)}  [${ratingLabel}]`);
      });
    }
    return lines;
  }

  function buildReport(data: any): string {
    const lines: string[] = [];
    const sep = "=".repeat(56);
    const dash = "-".repeat(56);

    lines.push(sep);
    lines.push("  RAPPORT AUDIT WEB — SOS-PC");
    lines.push("  " + new Date().toLocaleString("fr-FR"));
    lines.push("  URL : " + (data.finalUrl || data.url || "?"));
    lines.push(sep);
    lines.push("");

    const mScore = data.mobile?.scoreOverall ?? 0;
    const dScore = data.desktop?.scoreOverall ?? 0;
    lines.push(`SCORE GLOBAL`);
    lines.push(`  Mobile  : ${mScore}/100  (${verdictFor(mScore)})`);
    lines.push(`  Desktop : ${dScore}/100  (${verdictFor(dScore)})`);
    lines.push("");

    lines.push(dash);
    buildScoresLines("mobile", data.mobile).forEach((l) => lines.push(l));
    lines.push("");
    buildScoresLines("desktop", data.desktop).forEach((l) => lines.push(l));
    lines.push("");

    lines.push(dash);
    lines.push("MOBILE");
    lines.push(dash);
    buildVitalsLines(data.mobile).forEach((l) => lines.push(l));
    lines.push("");
    buildIssuesLines(data.mobile).forEach((l) => lines.push(l));

    lines.push(dash);
    lines.push("DESKTOP");
    lines.push(dash);
    buildVitalsLines(data.desktop).forEach((l) => lines.push(l));
    lines.push("");
    buildIssuesLines(data.desktop).forEach((l) => lines.push(l));

    lines.push(sep);
    lines.push("  Rapport SOS-PC — sos-pc.click/audit");
    lines.push(sep);
    return lines.join("\n");
  }

  // E10 — PDF download via jsPDF loaded dynamically on click
  pdfBtn.addEventListener("click", async () => {
    if (!lastReport) return;
    pdfLabel.textContent = "Génération…";
    pdfBtn.setAttribute("disabled", "true");

    try {
      // Load jsPDF from CDN only when the user clicks — no bundle cost otherwise
      const { jsPDF } = await import("https://cdn.jsdelivr.net/npm/jspdf@2.5.1/+esm" as any) as any;

      const doc = new jsPDF({ orientation: "portrait", unit: "pt", format: "a4" });
      const pageW = doc.internal.pageSize.getWidth();
      const margin = 40;
      const lineH = 13;
      const maxW = pageW - margin * 2;

      doc.setFont("courier", "normal");
      doc.setFontSize(8);

      let y = margin;

      function addLine(text: string, indent = 0) {
        const prefix = " ".repeat(indent);
        const wrapped = doc.splitTextToSize(prefix + text, maxW);
        wrapped.forEach((line: string) => {
          if (y > doc.internal.pageSize.getHeight() - margin) {
            doc.addPage();
            y = margin;
          }
          doc.text(line, margin, y);
          y += lineH;
        });
      }

      const reportText = buildReport(lastReport);
      const reportLines = reportText.split("\n");

      // Header — slightly bigger
      doc.setFontSize(9);
      addLine(reportLines[0] || "");
      doc.setFontSize(8);
      reportLines.slice(1).forEach((line) => addLine(line));

      // Tech stack appendix
      const techs: any[] = lastReport.techStack || [];
      if (techs.length > 0) {
        addLine("");
        addLine("=".repeat(56));
        addLine("  STACK TECHNIQUE DÉTECTÉE");
        addLine("=".repeat(56));
        addLine("");
        const grouped: Record<string, string[]> = {};
        techs.forEach((t: any) => {
          grouped[t.category] = grouped[t.category] || [];
          grouped[t.category].push(t.name + (t.version ? ` ${t.version}` : ""));
        });
        Object.entries(grouped).forEach(([cat, names]) => {
          addLine(`  ${cat.padEnd(12)} ${names.join(", ")}`);
        });
      }

      const filename = `audit-sos-pc-${new Date().toISOString().slice(0, 10)}.pdf`;
      doc.save(filename);
    } catch {
      alert("Impossible de générer le PDF. Vérifiez votre connexion internet.");
    } finally {
      pdfLabel.textContent = "Télécharger PDF";
      pdfBtn.removeAttribute("disabled");
    }
  });
</script>

