---
import Layout from "../layouts/Layout.astro";
import AsciiBackground from "../components/AsciiBackground.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Audit Web — SOS-PC" description="Analysez gratuitement les performances, le SEO et l'accessibilité de votre site web en 30 secondes. Rapport détaillé en français.">
  <AsciiBackground />
  <Navbar />
  <main id="main-content">
    <section class="audit-section">
      <div class="section-label">
        <span class="tag tag-blue">outil</span>
        <span class="mono text-muted">// Audit Web gratuit</span>
      </div>

      <div class="audit-header">
        <h1>Audit <span class="teal">Web</span> gratuit</h1>
        <p>Analysez les performances, le SEO, l'accessibilité et les bonnes pratiques de votre site. Rapport détaillé en français, prêt à transmettre.</p>
      </div>

      <div class="audit-input-wrap">
        <div class="audit-terminal">
          <div class="terminal-bar">
            <span class="t-dot red"></span>
            <span class="t-dot yellow"></span>
            <span class="t-dot green"></span>
            <span class="t-title">audit-web.sh — bash</span>
          </div>
          <div class="terminal-body">
            <div class="t-line">
              <span class="t-prompt">$</span>
              <span class="t-cmd">audit</span>
              <form id="audit-form" class="audit-form">
                <input
                  id="audit-url"
                  type="url"
                  name="url"
                  placeholder="https://votre-site.fr"
                  required
                  autocomplete="url"
                  spellcheck="false"
                  class="audit-input"
                />
                <button type="submit" class="audit-submit" id="audit-submit-btn">
                  <span id="audit-submit-label">Analyser</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
              </form>
            </div>

            <div id="audit-output" class="audit-output" style="display:none;">
              <div class="t-output" id="audit-status">Connexion au serveur d'analyse...</div>
            </div>
          </div>
        </div>
      </div>

      <div id="audit-results" class="audit-results" style="display:none;">

        <div class="audit-overview">
          <div class="overall-card">
            <div class="overall-ring" id="overall-ring">
              <span class="overall-val" id="overall-val">—</span>
              <span class="overall-suffix mono">/100</span>
            </div>
            <div class="overall-meta">
              <h2 id="overall-verdict" class="overall-verdict mono">Analyse</h2>
              <p id="overall-summary" class="overall-summary"></p>
            </div>
          </div>
          <div class="overall-screenshot" id="overall-screenshot" style="display:none;">
            <div class="screenshot-frame">
              <img id="screenshot-img" alt="Aperçu mobile du site" />
              <span class="screenshot-label mono">// vu sur mobile</span>
            </div>
          </div>
        </div>

        <div class="audit-scores" id="audit-scores"></div>

        <div class="vitals-wrap" id="vitals-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Core Web Vitals</h3>
          <p class="audit-section-sub">Les métriques que Google utilise pour juger l'expérience de vos visiteurs.</p>
          <div class="vitals-grid" id="vitals-grid"></div>
        </div>

        <div class="quickwins-wrap" id="quickwins-wrap" style="display:none;">
          <h3 class="audit-section-title mono">// Quick wins</h3>
          <p class="audit-section-sub">Actions rapides à fort impact pour faire grimper votre score.</p>
          <div class="quickwins-list" id="quickwins-list"></div>
        </div>

        <div class="audit-issues-wrap" id="audit-issues-wrap">
          <h3 class="audit-section-title mono">// Tous les problèmes détectés</h3>
          <p class="audit-section-sub" id="issues-sub"></p>
          <div id="audit-issues" class="audit-issues"></div>
        </div>

        <div class="audit-actions">
          <button class="btn-primary" id="audit-attach-btn" style="display:none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
            Joindre au formulaire de contact
          </button>
          <a href="/#contact" class="btn-ghost" id="audit-contact-btn" style="display:none;">
            Refaire mon site avec SOS-PC →
          </a>
        </div>
      </div>

    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("audit-form") as HTMLFormElement;
  const urlInput = document.getElementById("audit-url") as HTMLInputElement;
  const submitBtn = document.getElementById("audit-submit-btn") as HTMLButtonElement;
  const submitLabel = document.getElementById("audit-submit-label") as HTMLElement;
  const output = document.getElementById("audit-output") as HTMLElement;
  const status = document.getElementById("audit-status") as HTMLElement;
  const results = document.getElementById("audit-results") as HTMLElement;
  const scores = document.getElementById("audit-scores") as HTMLElement;
  const issuesWrap = document.getElementById("audit-issues-wrap") as HTMLElement;
  const issues = document.getElementById("audit-issues") as HTMLElement;
  const issuesSub = document.getElementById("issues-sub") as HTMLElement;
  const quickwinsWrap = document.getElementById("quickwins-wrap") as HTMLElement;
  const quickwinsList = document.getElementById("quickwins-list") as HTMLElement;
  const vitalsWrap = document.getElementById("vitals-wrap") as HTMLElement;
  const vitalsGrid = document.getElementById("vitals-grid") as HTMLElement;
  const overallRing = document.getElementById("overall-ring") as HTMLElement;
  const overallVal = document.getElementById("overall-val") as HTMLElement;
  const overallVerdict = document.getElementById("overall-verdict") as HTMLElement;
  const overallSummary = document.getElementById("overall-summary") as HTMLElement;
  const screenshotWrap = document.getElementById("overall-screenshot") as HTMLElement;
  const screenshotImg = document.getElementById("screenshot-img") as HTMLImageElement;
  const attachBtn = document.getElementById("audit-attach-btn") as HTMLElement;
  const contactBtn = document.getElementById("audit-contact-btn") as HTMLElement;

  let lastReport: any = null;

  const SCORE_LABELS = [
    { key: "performance", label: "Performance", icon: "⚡" },
    { key: "seo", label: "SEO", icon: "🔍" },
    { key: "accessibility", label: "Accessibilité", icon: "♿" },
    { key: "best-practices", label: "Bonnes pratiques", icon: "✓" },
  ];

  const EFFORT_LABELS: Record<string, { label: string; color: string }> = {
    easy: { label: "facile", color: "var(--accent-hex)" },
    medium: { label: "moyen", color: "var(--yellow)" },
    hard: { label: "important", color: "var(--purple)" },
  };

  function scoreColor(score: number): string {
    if (score >= 90) return "var(--accent-hex)";
    if (score >= 50) return "var(--yellow)";
    return "var(--red)";
  }

  function verdictFor(score: number): string {
    if (score >= 90) return "Excellent";
    if (score >= 70) return "Correct";
    if (score >= 50) return "À optimiser";
    return "Critique";
  }

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function renderOverall(data: any) {
    const score = data.scoreOverall ?? 0;
    const color = scoreColor(score);
    overallRing.style.setProperty("--pct", String(score));
    overallRing.style.setProperty("--color", color);
    overallVal.textContent = String(score);
    overallVal.style.color = color;
    overallVerdict.textContent = verdictFor(score);
    overallVerdict.style.color = color;

    const s = data.summary || { critical: 0, warning: 0, passed: 0 };
    const parts: string[] = [];
    if (s.critical) parts.push(`${s.critical} problème${s.critical > 1 ? "s" : ""} critique${s.critical > 1 ? "s" : ""}`);
    if (s.warning) parts.push(`${s.warning} amélioration${s.warning > 1 ? "s" : ""} possible${s.warning > 1 ? "s" : ""}`);
    if (s.passed) parts.push(`${s.passed} test${s.passed > 1 ? "s" : ""} réussi${s.passed > 1 ? "s" : ""}`);
    overallSummary.textContent = parts.length ? parts.join(" · ") : "Tous les tests sont passés.";
  }

  function renderScreenshot(data: any) {
    if (!data.screenshot) {
      screenshotWrap.style.display = "none";
      return;
    }
    screenshotImg.src = data.screenshot;
    screenshotWrap.style.display = "block";
  }

  function renderScores(data: Record<string, number>) {
    scores.innerHTML = "";
    SCORE_LABELS.forEach(({ key, label, icon }) => {
      const val = data[key] ?? 0;
      const pct = Math.round(val * 100);
      const color = scoreColor(pct);
      scores.innerHTML += `
        <div class="score-card">
          <div class="score-ring" style="--pct:${pct};--color:${color}">
            <span class="score-val" style="color:${color}">${pct}</span>
          </div>
          <span class="score-label mono">${icon} ${label}</span>
        </div>`;
    });
  }

  function renderVitals(vitals: any[]) {
    if (!vitals || vitals.length === 0) {
      vitalsWrap.style.display = "none";
      return;
    }
    vitalsWrap.style.display = "block";
    vitalsGrid.innerHTML = "";
    vitals.forEach((v: any) => {
      const ratingClass = v.rating === "good" ? "vital-good" : v.rating === "needs-improvement" ? "vital-warn" : "vital-poor";
      const ratingLabel = v.rating === "good" ? "Bon" : v.rating === "needs-improvement" ? "À améliorer" : "Mauvais";
      vitalsGrid.innerHTML += `
        <div class="vital-card ${ratingClass}">
          <span class="vital-label mono">${escapeHtml(v.label)}</span>
          <span class="vital-value">${escapeHtml(v.value)}</span>
          <span class="vital-rating mono">${ratingLabel}</span>
        </div>`;
    });
  }

  function renderQuickWins(items: any[]) {
    if (!items || items.length === 0) {
      quickwinsWrap.style.display = "none";
      return;
    }
    quickwinsWrap.style.display = "block";
    quickwinsList.innerHTML = "";
    items.forEach((item: any, idx: number) => {
      const effort = EFFORT_LABELS[item.effort] || EFFORT_LABELS.medium;
      quickwinsList.innerHTML += `
        <div class="qw-item">
          <span class="qw-num mono">${idx + 1}</span>
          <div class="qw-body">
            <div class="qw-head">
              <span class="qw-title">${escapeHtml(item.title)}</span>
              <span class="qw-tag mono" style="color:${effort.color};border-color:${effort.color}">effort ${effort.label}</span>
            </div>
            <span class="qw-desc">${escapeHtml(item.description || "")}</span>
            <span class="qw-cat mono">${escapeHtml(item.category || "")}</span>
          </div>
        </div>`;
    });
  }

  function renderIssues(items: any[]) {
    issues.innerHTML = "";
    if (!items || !items.length) {
      issuesWrap.style.display = "none";
      return;
    }
    issuesWrap.style.display = "block";
    issuesSub.textContent = `${items.length} audit${items.length > 1 ? "s" : ""} ayant échoué, triés par sévérité.`;

    items.forEach((item: any) => {
      const lvl = item.level === "error" ? "err" : item.level === "warning" ? "warn" : "ok";
      const icon = lvl === "err" ? "✗" : lvl === "warn" ? "⚠" : "✓";
      const effort = EFFORT_LABELS[item.effort] || EFFORT_LABELS.medium;
      issues.innerHTML += `
        <div class="issue-item issue-${lvl}">
          <span class="issue-icon mono">${icon}</span>
          <div class="issue-body">
            <div class="issue-head">
              <span class="issue-title">${escapeHtml(item.title)}</span>
              <span class="issue-cat mono">${escapeHtml(item.category || "")}</span>
              <span class="issue-effort mono" style="color:${effort.color};border-color:${effort.color}">${effort.label}</span>
            </div>
            <span class="issue-desc">${escapeHtml(item.description || "")}</span>
          </div>
        </div>`;
    });
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitLabel.textContent = loading ? "Analyse..." : "Analyser";
    urlInput.readOnly = loading;
  }

  function showOutput(text: string) {
    output.style.display = "block";
    status.textContent = text;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const url = urlInput.value.trim();
    if (!url) return;

    setLoading(true);
    results.style.display = "none";
    attachBtn.style.display = "none";
    contactBtn.style.display = "none";
    showOutput("Connexion au serveur d'analyse...");

    const steps = [
      "Résolution DNS...",
      "Chargement de la page (mobile, 4G simulé)...",
      "Mesure du temps de chargement...",
      "Analyse des Core Web Vitals...",
      "Audit SEO et accessibilité...",
      "Compilation du rapport...",
    ];

    let stepIdx = 0;
    const stepTimer = setInterval(() => {
      stepIdx++;
      if (stepIdx < steps.length) status.textContent = steps[stepIdx];
    }, 4000);

    try {
      const res = await fetch("/.netlify/functions/audit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url }),
      });

      clearInterval(stepTimer);

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: "Erreur serveur" }));
        throw new Error(err.error || `Erreur ${res.status}`);
      }

      const data = await res.json();
      lastReport = data;

      showOutput(`✓ Analyse terminée pour ${data.finalUrl || url}`);

      renderOverall(data);
      renderScreenshot(data);
      renderScores(data.scores || {});
      renderVitals(data.vitals || []);
      renderQuickWins(data.quickWins || []);
      renderIssues(data.issues || []);

      results.style.display = "block";
      attachBtn.style.display = "inline-flex";
      contactBtn.style.display = "inline-flex";
    } catch (err: any) {
      clearInterval(stepTimer);
      showOutput(`✗ Erreur : ${err.message || "Impossible d'analyser ce site."}`);
    } finally {
      setLoading(false);
    }
  });

  attachBtn.addEventListener("click", () => {
    if (!lastReport) return;
    const text = buildReport(lastReport);
    const payload = {
      text,
      generated: new Date().toLocaleString("fr-FR"),
      score: lastReport.scoreOverall ?? 0,
      issues: lastReport.issues || [],
      symptoms_user: [],
    };
    try {
      localStorage.setItem("sospc_web_audit_v1", JSON.stringify(payload));
    } catch {}
    window.location.href = "/#contact";
  });

  function buildReport(data: any): string {
    const lines: string[] = [];
    const sep = "=".repeat(56);
    const dash = "-".repeat(56);

    lines.push(sep);
    lines.push("  RAPPORT AUDIT WEB — SOS-PC");
    lines.push("  " + new Date().toLocaleString("fr-FR"));
    lines.push("  URL : " + (data.finalUrl || data.url || "?"));
    lines.push(sep);
    lines.push("");

    const overall = data.scoreOverall ?? 0;
    lines.push(`SCORE GLOBAL : ${overall}/100  (${verdictFor(overall)})`);
    const s = data.summary || {};
    if (s.critical || s.warning) {
      lines.push(`  ${s.critical || 0} critique(s) · ${s.warning || 0} amélioration(s) possible(s)`);
    }
    lines.push("");

    lines.push(dash);
    lines.push("SCORES PAR CATÉGORIE");
    lines.push(dash);
    SCORE_LABELS.forEach(({ key, label }) => {
      const pct = Math.round((data.scores?.[key] ?? 0) * 100);
      const filled = Math.round(pct / 5);
      const bar = "#".repeat(filled) + "-".repeat(20 - filled);
      lines.push(`${label.padEnd(18)} [${bar}] ${String(pct).padStart(3, " ")}/100`);
    });
    lines.push("");

    if (data.vitals && data.vitals.length) {
      lines.push(dash);
      lines.push("CORE WEB VITALS (perçu mobile)");
      lines.push(dash);
      data.vitals.forEach((v: any) => {
        const ratingLabel = v.rating === "good" ? "BON" : v.rating === "needs-improvement" ? "À AMÉLIORER" : "MAUVAIS";
        lines.push(`  ${v.label.padEnd(35)} ${v.value.padStart(8)}  [${ratingLabel}]`);
      });
      lines.push("");
    }

    if (data.quickWins && data.quickWins.length) {
      lines.push(dash);
      lines.push("ACTIONS RAPIDES (Quick wins)");
      lines.push(dash);
      data.quickWins.forEach((q: any, idx: number) => {
        lines.push(`  ${idx + 1}. ${q.title}  [effort ${q.effort}]`);
        if (q.description) lines.push(`     ${q.description}`);
        lines.push("");
      });
    }

    if (data.issues && data.issues.length) {
      lines.push(dash);
      lines.push(`PROBLÈMES DÉTECTÉS (${data.issues.length})`);
      lines.push(dash);
      data.issues.forEach((i: any) => {
        const lvl = i.level === "error" ? "[CRITIQUE]" : "[ATTENTION]";
        lines.push(`${lvl} ${i.title}  (${i.category || "—"} · effort ${i.effort})`);
        if (i.description) lines.push(`           ${i.description}`);
        lines.push("");
      });
    }

    lines.push(sep);
    lines.push("  Rapport SOS-PC — sos-pc.click/audit");
    lines.push(sep);
    return lines.join("\n");
  }
</script>

<style>
  .teal { color: var(--accent-hex); }
  .text-muted { color: var(--text-muted); }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .audit-section {
    padding: calc(var(--navbar-h) + 3rem) 0 5rem;
  }

  .audit-header {
    margin-bottom: 2.5rem;
  }

  .audit-header h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
  }

  .audit-header p {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.7;
    max-width: 600px;
  }

  .audit-terminal {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 0 30px #0006;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-elevated);
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
  }

  .t-dot { width: 12px; height: 12px; border-radius: 50%; }
  .t-dot.red { background: #f7768e; }
  .t-dot.yellow { background: #e0af68; }
  .t-dot.green { background: #00d4aa; }

  .t-title {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    margin-left: 8px;
  }

  .terminal-body {
    background: #0d0e14;
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
  }

  .t-line {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .t-prompt { color: var(--accent-hex); font-weight: 600; }
  .t-cmd { color: var(--text); }

  .audit-form {
    display: flex;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .audit-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 4px 8px;
    font-size: 13px;
    color: var(--accent-hex);
    font-family: var(--font-mono);
    outline: none;
    transition: border-color 0.2s;
  }

  .audit-input:focus { border-color: var(--accent-hex); }
  .audit-input::placeholder { color: var(--text-dim); }

  .audit-submit {
    background: var(--accent-hex);
    color: #1a1b26;
    border: none;
    border-radius: var(--radius);
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-mono);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .audit-submit:hover { box-shadow: 0 0 12px #00d4aa66; }

  .audit-submit:disabled {
    background: var(--border);
    color: var(--text-dim);
    cursor: wait;
    box-shadow: none;
  }

  .audit-output {
    margin-top: 12px;
    padding-left: 16px;
  }

  .t-output { color: var(--text-muted); }

  .audit-results { margin-top: 2.5rem; }

  /* ----- Overview (overall score + screenshot) ----- */

  .audit-overview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 2rem;
    align-items: stretch;
  }

  .overall-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .overall-ring {
    --pct: 0;
    --color: var(--accent-hex);
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: conic-gradient(
      var(--color) calc(var(--pct) * 1%),
      var(--border) calc(var(--pct) * 1%)
    );
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    flex-direction: column;
  }

  .overall-ring::before {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--bg-card);
  }

  .overall-val {
    position: relative;
    font-size: 32px;
    font-weight: 700;
    font-family: var(--font-mono);
    line-height: 1;
  }

  .overall-suffix {
    position: relative;
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .overall-meta { flex: 1; min-width: 0; }

  .overall-verdict {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .overall-summary {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .overall-screenshot {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screenshot-frame {
    position: relative;
    width: 100%;
    max-width: 200px;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
